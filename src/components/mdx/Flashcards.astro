---
// Study deck. Click/tap or press space to flip, arrows to move.
// <Flashcards title="Evidence of execution" cards={[{ q: 'Prefetch location?', a: 'C:\\Windows\\Prefetch' }]} />
interface Card { q: string; a: string }
interface Props { title?: string; cards: Card[] }
const { title = 'flashcards', cards } = Astro.props;
---
<section class="fc" data-fc tabindex="0" aria-label={`${title} flashcards`}>
  <header class="mono">
    <span>🃏 {title}</span>
    <span class="muted" data-count>1 / {cards.length}</span>
  </header>
  <div class="stage">
    {cards.map((c, i) => (
      <div class="card3d" data-i={i} hidden={i !== 0}>
        <div class="face front"><span class="lbl mono">Q</span><p set:html={c.q} /></div>
        <div class="face back"><span class="lbl mono">A</span><p set:html={c.a} /></div>
      </div>
    ))}
  </div>
  <footer class="mono">
    <button type="button" data-prev>← prev</button>
    <button type="button" data-flip>flip</button>
    <button type="button" data-shuffle>shuffle</button>
    <button type="button" data-next>next →</button>
  </footer>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-fc]').forEach((root) => {
    let cards = [...root.querySelectorAll<HTMLElement>('.card3d')];
    const count = root.querySelector('[data-count]')!;
    let i = 0;
    const show = () => {
      cards.forEach((c, n) => { c.hidden = n !== i; c.classList.remove('flipped'); });
      count.textContent = `${i + 1} / ${cards.length}`;
    };
    const flip = () => cards[i].classList.toggle('flipped');
    const go = (d: number) => { i = (i + d + cards.length) % cards.length; show(); };
    root.querySelector('[data-prev]')!.addEventListener('click', () => go(-1));
    root.querySelector('[data-next]')!.addEventListener('click', () => go(1));
    root.querySelector('[data-flip]')!.addEventListener('click', flip);
    root.querySelector('[data-shuffle]')!.addEventListener('click', () => {
      cards = cards.sort(() => Math.random() - 0.5);
      i = 0; show();
    });
    root.querySelector('.stage')!.addEventListener('click', flip);
    root.addEventListener('keydown', (e) => {
      if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); flip(); }
      if (e.key === 'ArrowRight') go(1);
      if (e.key === 'ArrowLeft') go(-1);
    });
  });
</script>

<style>
  .fc { margin: 2rem 0; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-2); outline: none; }
  .fc:focus-visible { border-color: var(--accent-dim); }
  header, footer { display: flex; justify-content: space-between; align-items: center; padding: 0.7rem 1rem; font-size: 0.8rem; gap: 0.5rem; }
  header { border-bottom: 1px solid var(--line); }
  footer { border-top: 1px solid var(--line); flex-wrap: wrap; }
  footer button {
    font: inherit; font-size: 0.75rem; color: var(--muted); background: none; cursor: pointer;
    border: 1px solid var(--line-2); border-radius: 6px; padding: 0.3rem 0.7rem;
  }
  footer button:hover { color: var(--accent); border-color: var(--accent-dim); }
  .stage { perspective: 1000px; padding: 1.2rem; cursor: pointer; }
  .card3d { position: relative; min-height: 170px; transition: transform 0.5s; transform-style: preserve-3d; }
  .card3d.flipped { transform: rotateY(180deg); }
  .face {
    position: absolute; inset: 0; backface-visibility: hidden;
    display: flex; align-items: center; justify-content: center; text-align: center;
    padding: 1.2rem 1.5rem; border-radius: 8px; border: 1px dashed var(--line-2);
    font-size: 1.05rem;
  }
  .face p { margin: 0; }
  .back { transform: rotateY(180deg); background: color-mix(in srgb, var(--accent) 5%, transparent); border-color: var(--accent-dim); color: #eafff2; }
  .lbl { position: absolute; top: 0.5rem; left: 0.7rem; font-size: 0.7rem; color: var(--dim); }
  .back .lbl { color: var(--accent); }
  @media (prefers-reduced-motion: reduce) { .card3d { transition: none; } }
</style>
