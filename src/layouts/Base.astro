---
import '../styles/global.css';
import { SITE, NAV, THEME, THEMES } from '../site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title, description = SITE.description, image } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : SITE.title;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const ogImage = new URL(image ?? SITE.photo, Astro.site);
---
<!doctype html>
<html lang="en" data-theme={THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="theme-color" content={THEMES[THEME].bg} />
    <script is:inline define:vars={{ themes: THEMES }}>
      try {
        const t = localStorage.getItem('theme');
        if (t && themes[t]) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a href="/" class="logo mono" aria-label="Home">
          <span class="prompt">root@</span><span class="host">brendorobo</span><span class="muted">:~#</span><span class="caret"></span>
        </a>
        <div class="right">
          <div class="theme-pick">
            <button class="theme-btn mono" type="button" aria-haspopup="true" aria-expanded="false" aria-label="Change color theme" title="theme">
              <span class="dot"></span>
            </button>
            <div class="theme-menu mono" role="menu" hidden>
              <div class="tm-h">// theme</div>
              {Object.entries(THEMES).map(([k, t]) => (
                <button type="button" role="menuitemradio" data-set-theme={k}>
                  <span class="sw" style={`background:${t.swatch}`}></span>{t.label}
                </button>
              ))}
            </div>
          </div>
          <button class="menu-btn mono" aria-expanded="false" aria-controls="site-nav">menu</button>
        </div>
        <nav id="site-nav" class="nav mono">
          {NAV.map((n) => (
            <a href={n.href} class:list={{ active: path.startsWith(n.href) }}>
              <span class="slash">/</span>{n.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot mono">
        <span>© {new Date().getFullYear()} {SITE.author} · chain of custody intact</span>
        <span class="links">
          <a href={SITE.github} rel="me">github</a>
          {SITE.linkedin && <a href={SITE.linkedin} rel="me">linkedin</a>}
          <a href="/rss.xml">rss</a>
        </span>
      </div>
    </footer>

    <script>
      // Mobile menu
      const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
      const nav = document.getElementById('site-nav');
      btn?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(!!open));
      });

      // Scroll reveal
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add('in'), io.unobserve(e.target))),
        { threshold: 0.12 }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Theme picker (the terminal's `theme` command fires the same event)
      const tBtn = document.querySelector<HTMLButtonElement>('.theme-btn')!;
      const tMenu = document.querySelector<HTMLElement>('.theme-menu')!;
      const opts = tMenu.querySelectorAll<HTMLButtonElement>('[data-set-theme]');
      const mark = () => opts.forEach((o) => o.setAttribute('aria-checked', String(o.dataset.setTheme === document.documentElement.dataset.theme)));
      const close = () => { tMenu.hidden = true; tBtn.setAttribute('aria-expanded', 'false'); };
      tBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        tMenu.hidden = !tMenu.hidden;
        tBtn.setAttribute('aria-expanded', String(!tMenu.hidden));
        mark();
      });
      opts.forEach((o) => o.addEventListener('click', () => {
        const t = o.dataset.setTheme!;
        document.documentElement.dataset.theme = t;
        try { localStorage.setItem('theme', t); } catch {}
        mark(); close();
      }));
      document.addEventListener('click', (e) => { if (!tMenu.contains(e.target as Node)) close(); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
    </script>
    {SITE.cfAnalyticsToken && (
      <script defer is:inline src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: SITE.cfAnalyticsToken })}></script>
    )}

    <style>
      .site-header {
        position: sticky; top: 0; z-index: 50;
        backdrop-filter: blur(10px);
        background: color-mix(in srgb, var(--bg) 78%, transparent);
        border-bottom: 1px solid var(--line);
      }
      .bar { display: flex; align-items: center; justify-content: space-between; height: 60px; gap: 1rem; }
      .logo { font-size: 0.95rem; color: var(--text); white-space: nowrap; }
      .logo:hover { text-decoration: none; }
      .prompt { color: var(--accent); }
      .host { color: var(--cyan); }
      .caret {
        display: inline-block; width: 8px; height: 1.05em; margin-left: 4px;
        background: var(--accent); vertical-align: text-bottom;
        animation: blink 1.1s steps(1) infinite;
      }
      @keyframes blink { 50% { opacity: 0; } }
      .nav { display: flex; gap: 1.3rem; font-size: 0.88rem; margin-left: auto; order: 2; }
      .nav a { color: var(--muted); }
      .nav a:hover, .nav a.active { color: var(--accent); text-decoration: none; }
      .slash { color: var(--dim); }
      .right { display: flex; align-items: center; gap: 0.6rem; order: 3; }
      .theme-pick { position: relative; }
      .theme-btn {
        width: 32px; height: 32px; display: grid; place-items: center; cursor: pointer;
        background: none; border: 1px solid var(--line-2); border-radius: 8px;
      }
      .theme-btn:hover { border-color: var(--accent-dim); }
      .dot { width: 14px; height: 14px; border-radius: 50%; background: conic-gradient(var(--accent), var(--accent-2), var(--accent)); box-shadow: 0 0 10px var(--accent); }
      .theme-menu {
        position: absolute; right: 0; top: calc(100% + 8px); min-width: 160px; padding: 0.4rem;
        background: var(--panel); border: 1px solid var(--line-2); border-radius: 10px;
        box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.6); z-index: 70;
      }
      .tm-h { font-size: 0.68rem; color: var(--dim); padding: 0.3rem 0.5rem; }
      .theme-menu button {
        display: flex; align-items: center; gap: 0.6rem; width: 100%; padding: 0.45rem 0.5rem;
        font: inherit; font-size: 0.82rem; color: var(--text); background: none; border: 0; border-radius: 6px; cursor: pointer; text-align: left;
      }
      .theme-menu button:hover { background: var(--panel-2); }
      .theme-menu button[aria-checked='true'] { color: var(--accent); }
      .theme-menu button[aria-checked='true']::after { content: '●'; margin-left: auto; font-size: 0.6rem; }
      .sw { width: 12px; height: 12px; border-radius: 50%; flex: none; }
      .menu-btn {
        display: none; background: none; border: 1px solid var(--line-2);
        color: var(--text); border-radius: 6px; padding: 0.3rem 0.7rem; cursor: pointer;
      }
      @media (max-width: 860px) {
        .logo .prompt { display: none; }
        .menu-btn { display: block; }
        .nav {
          display: none; position: absolute; top: 60px; left: 0; right: 0;
          flex-direction: column; gap: 0; background: var(--bg-2);
          border-bottom: 1px solid var(--line);
        }
        .nav.open { display: flex; }
        .nav a { padding: 0.9rem 16px; border-top: 1px solid var(--line); }
      }
      .site-footer { border-top: 1px solid var(--line); margin-top: 5rem; }
      .foot {
        display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem;
        padding: 1.6rem 16px; font-size: 0.8rem; color: var(--dim);
      }
      .links { display: flex; gap: 1.2rem; }
      .links a { color: var(--muted); }
    </style>
  </body>
</html>
