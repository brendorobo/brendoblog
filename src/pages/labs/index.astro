---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getLabs } from '../../lib/content';

const labs = await getLabs();
const groups = (['active', 'complete', 'planned'] as const)
  .map((s) => ({ status: s, labs: labs.filter((l) => l.data.status === s) }))
  .filter((g) => g.labs.length);
---
<Base title="Labs" description="Hands-on projects and experiments.">
  <section class="wrap">
    <div class="top">
      <div class="eyebrow">// the workbench</div>
      <h1>Labs &amp; experiments</h1>
      <p class="muted">Hands-on builds: homelab setups, tooling, practice cases, and whatever I’m tinkering with.</p>
    </div>
    {groups.map((g) => (
      <>
        <div class="section-head"><h2>{g.status}</h2><span class="mono muted">{g.labs.length}</span></div>
        <div class="grid">
          {g.labs.map((l) => (
            <PostCard
              href={`/labs/${l.id}/`}
              title={l.data.title}
              description={l.data.description}
              date={l.data.date}
              label={l.data.status}
              tags={l.data.stack}
              cover={l.data.cover}
            />
          ))}
        </div>
      </>
    ))}
  </section>
</Base>

<style>
  .top { padding: 3rem 0 0; }
  h1 { margin: 0.6rem 0 0.4rem; }
  .grid { display: grid; gap: 1.2rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
</style>
