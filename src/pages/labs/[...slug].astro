---
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { getLabs, readingTime } from '../../lib/content';

export async function getStaticPaths() {
  const labs = await getLabs();
  return labs.map((lab) => ({ params: { slug: lab.id }, props: { lab } }));
}

const { lab } = Astro.props;
const { Content, headings } = await render(lab);
const d = lab.data;
const extra = [
  { k: 'status', v: d.status },
  ...(d.stack.length ? [{ k: 'stack', v: d.stack.join(' · ') }] : []),
  ...(d.repo ? [{ k: 'repo', v: d.repo.replace('https://github.com/', ''), href: d.repo }] : []),
];
---
<Article
  title={d.title}
  description={d.description}
  date={d.date}
  label="lab"
  cover={d.cover}
  headings={headings}
  readMins={readingTime(lab.body)}
  back={{ href: '/labs/', label: 'all labs' }}
  extra={extra}
>
  <Content />
</Article>
