---
import Base from '../layouts/Base.astro';
import TerminalHero from '../components/TerminalHero.astro';
import PostCard from '../components/PostCard.astro';
import LinkedInCard from '../components/LinkedInCard.astro';
import { getPosts, getLinkedIn, readingTime } from '../lib/content';
import { CURRENT_CERT } from '../data/journey';
import { NOW, STUDY_LOG, MOODS } from '../data/now';
import { SITE } from '../site';

const posts = await getPosts();
const updates = await getLinkedIn();
const items = [
  ...posts.map((p) => ({ title: p.data.title, kind: 'write-up' as const, href: `/blog/${p.id}/` })),
  ...updates.map((u) => ({ title: u.data.title, kind: 'post' as const, href: `/posts/#${u.id}` })),
];
const lastLog = STUDY_LOG[0];
const moodLevel = (NOW.mood.level || lastLog?.mood) as keyof typeof MOODS | undefined;
const mood = moodLevel ? MOODS[moodLevel] : undefined;
const moodText = NOW.mood.text || lastLog?.note;
---
<Base>
  <section class="wrap hero">
    <div class="intro">
      <a class="me" href="/about/">
        <img src={SITE.avatar} alt="" width="44" height="44" />
        <span><strong>Brendon Roberts</strong><span class="mono">cybersecurity analyst · DFIR · <span class="eagle">⚜ eagle scout</span></span></span>
      </a>
      <div class="eyebrow">// digital forensics · incident response · write-ups</div>
      <h1>Learning DFIR in public, <span class="hl">one artifact at a time.</span></h1>
      <p class="lede">
        I’m Brendon, a cybersecurity analyst working in SOC operations and incident response. I’m going deeper into forensics and working toward the{' '}
        <strong>{CURRENT_CERT.name}</strong>. Here I write up what I study, the cases and CTFs I work through, and what I learn from them.
      </p>
      <div class="cta">
        <a class="btn" href="/blog/">read the write-ups →</a>
        <a class="btn ghost" href="/resume/">resume</a>
      </div>
    </div>
    <TerminalHero items={items} />
  </section>

  <section class="wrap">
    <div class="card now reveal">
      <div class="now-head mono">
        <span><span class="pulse"></span>currently</span>
        <span class="muted">updated {NOW.updated}</span>
      </div>
      <dl>
        {NOW.items.map((i) => (
          <div><dt class="mono">{i.k}</dt><dd>{i.v}</dd></div>
        ))}
        {mood && (
          <div><dt class="mono">feeling</dt><dd><span class="mood">{mood.emoji} {mood.label}</span>{moodText && <span class="muted"> · {moodText}</span>}</dd></div>
        )}
      </dl>
      <a class="mono more" href="/journey/">{CURRENT_CERT.name} journey →</a>
    </div>

    <div class="section-head">
      <h2>latest write-ups</h2>
      <a class="mono" href="/blog/">all write-ups →</a>
    </div>
    <div class="grid">
      {posts.slice(0, 3).map((p) => (
        <PostCard
          href={`/blog/${p.id}/`}
          title={p.data.title}
          description={p.data.description}
          date={p.data.date}
          label={p.data.category}
          tags={p.data.tags}
          cover={p.data.cover}
          readMins={readingTime(p.body)}
        />
      ))}
    </div>

    <div class="section-head">
      <h2>recent posts</h2>
      <a class="mono" href="/posts/">all posts →</a>
    </div>
    <div class="grid">
      {updates.slice(0, 3).map((u) => <LinkedInCard item={u} compact />)}
    </div>

  </section>
</Base>

<style>
  .hero {
    display: grid; gap: 2.5rem; align-items: center;
    padding-top: 3.5rem; padding-bottom: 1rem;
  }
  @media (min-width: 960px) { .hero { grid-template-columns: 1.05fr 1fr; padding-top: 5rem; } }
  h1 { margin: 0.8rem 0 1rem; }
  .me { display: inline-flex; align-items: center; gap: 0.7rem; margin-bottom: 1.4rem; color: var(--text); padding: 0.35rem 0.9rem 0.35rem 0.35rem; border: 1px solid var(--line-2); border-radius: 999px; background: var(--bg-2); }
  .me:hover { text-decoration: none; border-color: var(--accent-dim); }
  .me img { width: 44px; height: 44px; border-radius: 50%; border: 2px solid var(--accent-dim); object-fit: cover; }
  .me > span { display: flex; flex-direction: column; line-height: 1.25; }
  .me strong { font-size: 0.92rem; }
  .me .mono { font-size: 0.7rem; color: var(--muted); }
  .eagle { color: var(--amber); }
  .hl {
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .lede { color: var(--muted); font-size: 1.1rem; max-width: 52ch; }
  .lede strong { color: var(--amber); }
  .cta { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-top: 1.5rem; }
  .btn.ghost { border-color: var(--line-2); color: var(--text); background: transparent; }
  .grid { display: grid; gap: 1.2rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  .now { margin-top: 2.5rem; padding: 1.1rem 1.3rem; display: grid; gap: 0.6rem; }
  .now-head { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); }
  .pulse { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); margin-right: 0.5rem; box-shadow: 0 0 0 0 var(--accent); animation: pulse 2s infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 8px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }
  .now dl { margin: 0; display: grid; gap: 0.35rem; }
  .now dl div { display: grid; grid-template-columns: 6.5rem 1fr; gap: 1rem; align-items: baseline; }
  .now dt { font-size: 0.78rem; color: var(--dim); }
  .now dd { margin: 0; font-size: 1.02rem; }
  .mood { color: var(--amber); }
  .more { font-size: 0.78rem; justify-self: start; }
  @media (prefers-reduced-motion: reduce) { .pulse { animation: none; } }
</style>
