---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
import { CERTS } from '../data/journey';
import { EXPERIENCE } from '../data/resume';

const earned = CERTS.filter((c) => c.status === 'done');
---
<Base title="whoami" description="Brendon Roberts: cybersecurity analyst focused on SOC operations and DFIR.">
  <section class="wrap about">
    <div class="eyebrow">// $ whoami</div>
    <h1>Brendon Roberts <span class="mono handle">aka brendorobo</span></h1>

    <div class="grid">
      <div class="prose">
        <p>
          I’m a <strong>cybersecurity analyst</strong> at a regional electric utility, with over two years in incident
          response, digital forensics and security operations. Day to day that means investigating incidents across
          endpoints, identities, email and cloud, digging into phishing and malware, hunting for what slipped past
          detections, and writing it all up. The part I enjoy most is the forensics: figuring out what <em>actually</em> happened on a machine.
        </p>
        <p>
          That’s why I’m going deeper into <strong>DFIR</strong> and working toward the <strong>GCFA</strong>{' '}
          (SANS FOR508). This blog is where I write that up: study notes, CTF write-ups, tools I’m
          testing, and the “oh, <em>that’s</em> how it works” moments.
        </p>
        <p>
          I hold a B.S. in Cybersecurity &amp; Information Assurance from WGU and an A.A.S. from Stark State, both
          earned while working full-time. I’m also an <strong class="eagle">⚜ Eagle Scout</strong>, which taught me
          discipline, integrity and accountability. Those carry straight into how I approach an investigation:
          document everything and follow the evidence.
        </p>

        <h2>Experience</h2>
        <p class="muted small">Highlights below. The full version is on my <a href="/resume/">resume page</a>.</p>
        <ol class="xp">
          {EXPERIENCE.map((x) => (
            <li class="reveal">
              <div class="xp-head">
                <strong>{x.role}</strong> <span class="muted">· {x.org}</span>
                <span class="mono when">{x.when}</span>
              </div>
              <ul>{x.points.slice(0, 3).map((p) => <li>{p}</li>)}</ul>
            </li>
          ))}
        </ol>

        <p class="muted small">
          Opinions are my own and don’t represent my employer. Nothing shared here is confidential or
          identifies any organization’s systems, data or incidents.
        </p>
      </div>

      <aside class="card idcard mono">
        <figure class="mug">
          <img src={SITE.photo} alt="Brendon Roberts" width="1000" height="1000" />
          <figcaption><span>exhibit A</span><span>analyst_photo.webp</span></figcaption>
        </figure>
        <div class="row"><span>name</span><span>Brendon Roberts</span></div>
        <div class="row"><span>handle</span><span>brendorobo</span></div>
        <div class="row"><span>role</span><span>Cybersecurity Analyst</span></div>
        <div class="row"><span>focus</span><span>SOC · DFIR</span></div>
        <div class="row"><span>degree</span><span>B.S. Cybersecurity &amp; IA</span></div>
        <div class="row"><span>studying</span><span class="y">GCFA (FOR508)</span></div>
        <div class="row"><span>exam goal</span><span>December 2026</span></div>
        <div class="row"><span>honors</span><span class="eagle">⚜ Eagle Scout</span></div>
        <div class="row"><span>status</span><span class="g">● learning</span></div>
        <div class="certs">
          {earned.map((c) => <span class="cert">{c.name}</span>)}
        </div>
        <div class="links">
          <a class="btn" href="/resume/">resume</a>
          <a class="btn" href={SITE.github}>github</a>
          {SITE.linkedin && <a class="btn" href={SITE.linkedin}>linkedin</a>}
          {SITE.email && <a class="btn" href={`mailto:${SITE.email}`}>email</a>}
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .about { padding-top: 3rem; }
  h1 { margin: 0.6rem 0 2rem; }
  .handle { font-size: 0.45em; color: var(--muted); font-weight: 400; vertical-align: middle; }
  .grid { display: grid; gap: 2.5rem; }
  @media (min-width: 900px) { .grid { grid-template-columns: 1fr 320px; align-items: start; } }
  .idcard { padding: 1.2rem 1.3rem; font-size: 0.82rem; position: sticky; top: 90px; }
  .mug { position: relative; margin: 0 0 1rem; border-radius: 8px; overflow: hidden; border: 1px solid var(--line-2); }
  .mug img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; }
  .mug::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: repeating-linear-gradient(to bottom, transparent 0 3px, rgba(0, 0, 0, 0.08) 3px 4px),
      linear-gradient(to top, color-mix(in srgb, var(--bg) 70%, transparent), transparent 40%);
  }
  .mug figcaption {
    position: absolute; left: 0.6rem; right: 0.6rem; bottom: 0.45rem; z-index: 1;
    display: flex; justify-content: space-between; font-size: 0.66rem; color: var(--accent);
  }
  @media (max-width: 899px) { .idcard { position: static; } .mug { max-width: 320px; } }
  .row { display: flex; justify-content: space-between; gap: 1rem; padding: 0.5rem 0; border-bottom: 1px dashed var(--line); }
  .row span:first-child { color: var(--dim); }
  .row span:last-child { text-align: right; }
  .y { color: var(--amber); } .g { color: var(--accent); }
  .eagle { color: var(--amber); }
  .certs { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1rem; }
  .cert { font-size: 0.75rem; padding: 0.15rem 0.55rem; border: 1px solid var(--accent-dim); color: var(--accent); border-radius: 5px; }
  .links { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 1.2rem; }
  .small { font-size: 0.85rem; }
  .xp { list-style: none; padding: 0 0 0 1.2rem; margin: 1rem 0 2rem; border-left: 1px dashed var(--line-2); }
  .xp > li { position: relative; padding: 0 0 1.4rem 0.4rem; }
  .xp > li::before {
    content: ''; position: absolute; left: calc(-1.2rem - 5px); top: 0.55rem;
    width: 9px; height: 9px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px var(--accent);
  }
  .xp > li:not(:first-child)::before { background: var(--line-2); box-shadow: none; }
  .xp-head { display: flex; flex-wrap: wrap; gap: 0.3rem 0.5rem; align-items: baseline; }
  .when { font-size: 0.75rem; color: var(--dim); margin-left: auto; }
  .xp ul { margin: 0.4rem 0 0; padding-left: 1.1rem; }
  .xp ul li { font-size: 0.95rem; margin: 0.15rem 0; }
</style>
