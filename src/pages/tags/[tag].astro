---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, readingTime } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { posts: posts.filter((p) => p.data.tags.includes(tag)) } }));
}
const { tag } = Astro.params;
const { posts } = Astro.props;
---
<Base title={`#${tag}`}>
  <section class="wrap">
    <div class="top">
      <div class="eyebrow">// grep -r "#{tag}"</div>
      <h1>#{tag}</h1>
      <p class="muted">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
    </div>
    <div class="grid">
      {posts.map((p) => (
        <PostCard href={`/blog/${p.id}/`} title={p.data.title} description={p.data.description} date={p.data.date}
          label={p.data.category} tags={p.data.tags} cover={p.data.cover} readMins={readingTime(p.body)} />
      ))}
    </div>
  </section>
</Base>

<style>
  .top { padding: 3rem 0 2rem; }
  h1 { margin: 0.6rem 0 0.4rem; }
  .grid { display: grid; gap: 1.2rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
</style>
