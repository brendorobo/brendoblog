---
import Base from '../layouts/Base.astro';
---
<Base title="404">
  <section class="wrap nf mono">
    <div class="code">404</div>
    <p><span class="r">[!]</span> artifact not found: <span class="y">{Astro.url.pathname}</span></p>
    <p class="muted">Possibly wiped, timestomped, or never existed. The $MFT has no record of it.</p>
    <a class="btn" href="/">← return to /</a>
  </section>
</Base>

<style>
  .nf { padding: 6rem 16px; text-align: center; }
  .code {
    font-size: clamp(5rem, 20vw, 9rem); font-weight: 700; line-height: 1; color: transparent;
    -webkit-text-stroke: 1px var(--accent); text-shadow: 0 0 40px rgba(57, 255, 136, 0.35);
  }
  .r { color: var(--red); } .y { color: var(--amber); }
</style>
